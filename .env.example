# Local-only DeepSeek testing. Never publish this key in a VITE build.
VITE_DEEPSEEK_API_KEY=
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com
VITE_DEEPSEEK_API_PROXY_URL=

# Image generation defaults
VITE_APIMART_BASE_URL=https://api.apimart.ai
VITE_APIMART_IMAGE_MODEL=gpt-image-2
VITE_APIMART_IMAGE_SIZE=1:1
VITE_APIMART_IMAGE_RESOLUTION=1k

# Preferred production path: a server-side proxy exposing the same /v1 endpoints.
VITE_IMAGE_API_PROXY_URL=

# Local-only direct APIMart testing. Do not put this in GitHub Pages builds.
VITE_APIMART_API_KEY=
